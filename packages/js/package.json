{
  "name": "@docsorb/sdk",
  "version": "0.1.1",
  "description": "DocsOrb SDK — createClient, then guardrails.evaluate / sanitise / anonymise.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "docsorb",
    "guardrails",
    "ai",
    "sdk"
  ],
  "author": "DocsOrb",
  "license": "MIT",
  "homepage": "https://github.com/docsorb/docsorb-sdk/tree/main/packages/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docsorb/docsorb-sdk.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/docsorb/docsorb-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
